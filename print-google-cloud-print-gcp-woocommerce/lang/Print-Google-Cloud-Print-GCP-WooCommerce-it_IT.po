#: setting/setting.php:58
msgid "Custom Request Timeout"
msgstr "Tempo di richiesta personalizzato"

#: setting/setting.php:61
msgid "Override the default WordPress HTTP timeout (5 seconds) for print service requests."
msgstr "Override the default WordPress Timeout HTTP (5 secondi) per le richieste di servizio di stampa."

#: setting/setting.php:69
msgid "Timeout (seconds)"
msgstr "Timeout (secondi)"

#: setting/setting.php:73
msgid "Number of seconds to wait for print service response. Recommended: 10-30 seconds."
msgstr "Numero di secondi per attendere la risposta del servizio di stampa. Consigliato: 10-30 secondi."

#: setting/setting.php:80
msgid "Enable Network Retry"
msgstr "Abilitare la rete Retry"

#: setting/setting.php:83
msgid "Retry failed print requests once on connection timeout or network errors. Note: May cause duplicate prints if the server received the original request."
msgstr "Ripristina le richieste di stampa fallite una volta su timeout di connessione o errori di rete. Nota: può causare stampe duplicate se il server ha ricevuto la richiesta originale."

#: setting/setting.php:91
msgid "Disable SSL Verification"
msgstr "Disattivare la verifica SSL"

#: setting/setting.php:94
msgid "Disable SSL certificate verification for print service requests. Only enable if you have TLS inspection or custom certificate authorities in your network."
msgstr "Disattivare la verifica del certificato SSL per le richieste di servizio di stampa. Attivare solo se si dispone di controllo TLS o autorità di certificazione personalizzate nella rete."

#: setting/setting.php:96
msgid "Disable"
msgstr "Disabilita"

#: setting/setting.php:102
msgid "Background Print Processing"
msgstr "Elaborazione della stampa di sfondo"

#: setting/setting.php:105
msgid "Process print jobs in the background instead of during checkout. Checkout completes immediately and print jobs are sent asynchronously. Recommended for sites experiencing print service timeouts."
msgstr "Elaborare lavori di stampa sullo sfondo invece che durante il checkout. Il checkout si completa immediatamente e i lavori di stampa vengono inviati in modo asincrono. Consigliato per i siti che vivono timeout di servizio di stampa."

#: setting/setting.php:113
msgid "Queue Failed Jobs"
msgstr "Queue Failed Jobs"

#: setting/setting.php:116
msgid "When a print job fails during checkout, automatically queue it for background retry. Jobs will retry with increasing delays up to 5 times. Only applies when Background Print Processing is disabled."
msgstr "Quando un lavoro di stampa fallisce durante il checkout, in coda automaticamente per la riprova di sfondo. I lavori ricercheranno con crescenti ritardi fino a 5 volte. Si applica solo quando l'elaborazione della stampa di sfondo è disabilitata."

